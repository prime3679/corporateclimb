# Build-time analytics keys. Leave unset for dev, e2e and forks — the
# adapter in src/analytics.ts is a no-op without VITE_POSTHOG_KEY.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional: stamped into every event as `build`.
VITE_BUILD_SHA=

# Daily leaderboard (api/daily-leaderboard.js) — Vercel KV / Upstash REST.
# Set in Vercel → Project → Settings → Environment Variables, never here.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Title coffee CTA (PR #135) — hidden when unset.
# VITE_COFFEE_PAYMENT_URL=
